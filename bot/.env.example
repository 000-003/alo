# ─── Serveur ───
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cardinal_alo
DB_USER=user1808
DB_PASSWORD=0000
