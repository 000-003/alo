# ─── Serveur ───
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cardinal_alo
DB_USER=user1808
DB_PASSWORD=0000
DB_POOL_SIZE=10

# ─── Redis (file d'attente / cache) ───
REDIS_URL=redis://localhost:6379

# ─── API LLM (choisis un fournisseur gratuit) ───
USE_API=false
LLM_PROVIDER=groq
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HF_API_KEY=
GEMINI_API_KEY=

# ─── WhatsApp (optionnel, P2) ───
WA_SESSION_PATH=./wa_session

# ─── Modèles ONNX (P3) ───
MODEL_INTENT=intent.onnx
MODEL_NER=ner.onnx
MODEL_COMBAT=combat.onnx
MODEL_EMBED=embed.onnx

# ─── Quotas LLM ───
GROQ_QUOTA=60
GROQ_PER_TICK=10
MISTRAL_QUOTA=50
MISTRAL_PER_TICK=10
OPENROUTER_QUOTA=200
OPENROUTER_PER_TICK=20
HF_QUOTA=100
HF_PER_TICK=10
GEMINI_QUOTA=60
GEMINI_PER_TICK=10

# ─── Administration GM (numéros WhatsApp séparés par des virgules) ───
# Exemple : GM_PHONES=33612345678,33698765432
GM_PHONES=

# ─── Paramètres jeu ───
MAX_PLAYERS=300
TICK_RATE_MS=1000
STARTING_YRDS=500
STARTING_ZONE=ZONE_NEU_CAP_001
